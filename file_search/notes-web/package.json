{
  "name": "notes-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "file_search_app 便利貼的網頁版——Vite + React 前端，Fastify 後端；直接讀寫桌面版的 indexes/.sticky_notes.json，兩邊共用同一份資料。新增／編輯／刪除即時反映在 UI 上。",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "share": "node scripts/share-serve.mjs",
    "lint": "oxlint"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@tanstack/react-query": "^5",
    "fastify": "^5",
    "lucide-react": "^1.30.0",
    "qrcode-generator": "^1.5.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9",
    "cross-env": "^7.0.3",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
